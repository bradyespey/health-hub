rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAuthorizedUser() {
      return request.auth != null &&
        request.auth.token.email in [
          'baespey@gmail.com',
          'bradyjennytx@gmail.com',
          'jennycespey@gmail.com'
        ];
    }

    function isOwner(userId) {
      return isAuthorizedUser() && request.auth.uid == userId;
    }

    // User profile doc (role, preferences) + per-user scratch-off prizes subcollection
    match /users/{userId} {
      allow read, write: if isOwner(userId);

      match /scratchOffPrizes/{prizeId} {
        allow read, write: if isOwner(userId);
      }
    }

    // Per-user dashboard layout, presets
    match /layouts/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Per-user Apple Health data (appleHealth/{userId}/{dateStr}/{type}, .../latest/summary)
    match /appleHealth/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Per-user text cards (textCards/{userId}/{page}/{cardId})
    match /textCards/{userId}/{document=**} {
      allow read, write: if isOwner(userId);
    }

    // Shared app-wide settings (single doc, read/write by any authorized household member)
    match /system/settings {
      allow read, write: if isAuthorizedUser();
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
